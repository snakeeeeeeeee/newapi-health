{
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "defaults": {
        "baseUrl": "https://api.openai.com",
        "endpoint": "/v1/chat/completions",
        "enabled": true
      },
      "groups": [
        {
          "id": "default-openai",
          "defaults": {
            "apiKey": "sk-replace-me",
            "model": "gpt-4o-mini",
            "description": "OpenAI 官方接口示例。"
          },
          "models": ["openai-primary"]
        }
      ]
    },
    {
      "id": "claude",
      "name": "Anthropic",
      "defaults": {
        "baseUrl": "https://your-proxy.example.com",
        "endpoint": "/v1/messages",
        "description": "Anthropic Messages API 示例。",
        "enabled": true
      },
      "groups": [
        {
          "id": "claude-max",
          "defaults": {
            "apiKey": "sk-replace-me"
          },
          "models": [
            "claude-haiku-4-5",
            "claude-sonnet-4-6",
            "claude-opus-4-6"
          ]
        }
      ]
    },
    {
      "id": "gemini",
      "name": "Google",
      "defaults": {
        "baseUrl": "https://your-proxy.example.com",
        "endpoint": "/v1beta/models/{model}:generateContent",
        "description": "Google Gemini API 示例。",
        "enabled": true
      },
      "groups": [
        {
          "id": "gemini-flash",
          "defaults": {
            "apiKey": "sk-replace-me",
            "model": "gemini-2.0-flash"
          },
          "models": ["gemini-primary"]
        }
      ]
    }
  ]
}
